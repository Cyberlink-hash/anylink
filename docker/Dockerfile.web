FROM docker.io/library/node:24-alpine3.23@sha256:9b69af715c7f9d038150b54ccccbaeffa9064bbc93e2904c29591ca097316af1 AS builder_web

WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node web/package.json web/yarn.lock ./
RUN sha256sum package.json yarn.lock > /tmp/dependencies.sha256 \
    && yarn install --frozen-lockfile --ignore-scripts --non-interactive --registry=https://registry.npmjs.org \
    && sha256sum -c /tmp/dependencies.sha256
COPY --chown=node:node web/src ./src
COPY --chown=node:node web/public ./public
COPY --chown=node:node web/babel.config.js web/vue.config.js ./
# Vue CLI 4 / webpack 4 使用旧版哈希算法；只在离线构建步骤启用兼容。
RUN --network=none NODE_OPTIONS=--openssl-legacy-provider yarn run build

FROM scratch
COPY --from=builder_web /app/ui /ui
CMD ["/unused"]
